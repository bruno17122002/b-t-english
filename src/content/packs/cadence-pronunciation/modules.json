  {
    "id": "r-l-distinction",
    "order": 5,
    "title": "R / L Distinction",
    "description": "Nail the /ɹ/ and /l/ contrast — a key clarity marker in English.",
    "phonemeFocus": [
      "/ɹ/",
      "/l/"
    ],
    "focusSymbols": [
