{
  "name": "lingua-quest",
  "productName": "Lingua Quest",
  "version": "1.0.0",
  "description": "Personalized AI English learning adventure for Vietnamese learners",
  "author": "Lingua Quest",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "electron-vite build && playwright test",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "icons": "python -I scripts/make_icons.py",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir --publish never"
  },
  "dependencies": {
    "sql.js": "^1.15.2",
    "ts-fsrs": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.10.2",
    "electron-builder": "^26.18.1",
    "electron-vite": "^4.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "framer-motion": "^12.43.0",
    "globals": "^17.14.0",
    "lucide-react": "^1.68.0",
    "prettier": "^3.9.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^3.2.4",
    "zustand": "^5.0.16"
  }
}
