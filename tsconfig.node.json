{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "web/vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/core/**/*",
    "src/modules/contract.ts",
    "src/modules/registry.main.ts",
    "src/modules/types.main.ts",
    "src/modules/*/contract.ts",
    "src/modules/*/types.ts",
    "src/modules/*/shared/**/*",
    "src/modules/*/main/**/*",
    "src/content/*.json",
    "src/content/packs/**/*.json",
    "tests/**/*",
    "supabase/functions/_shared/**/*.ts"
  ],
  "exclude": ["tests/renderer/**/*", "tests/e2e/**/*", "tests/unit/web-*.test.ts"]
}
