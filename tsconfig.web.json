{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [],
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@core/*": ["src/core/*"],
      "@modules/*": ["src/modules/*"],
      "@/*": ["src/renderer/src/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/shared/**/*",
    "src/core/**/*",
    "src/modules/contract.ts",
    "src/modules/registry.renderer.tsx",
    "src/modules/*/contract.ts",
    "src/modules/*/renderer/**/*",
    "src/preload/api.d.ts"
  ]
}
